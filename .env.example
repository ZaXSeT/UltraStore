# UltraStore Environment Configuration Example
# Copy to .env.local for local overrides

# App
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=UltraStore
NEXT_PUBLIC_STORE_CITY=Jakarta

# Database (SQLite with node:sqlite stdlib)
DATABASE_PATH=./data/ultrastore.db

# Payments (Midtrans Sandbox / Mock Provider)
MIDTRANS_SERVER_KEY=mock-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=mock-client-key
MIDTRANS_IS_PRODUCTION=false

# Shipping
SHIPPING_ORIGIN_CITY=Jakarta Selatan
SHIPPING_DEFAULT_RATE=25000

# Auth & Security
GUEST_TOKEN_SECRET=dev-secret-token-sign-key-change-in-production
SESSION_SECRET=dev-session-secret-change-in-production

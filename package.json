{
  "name": "ultrastore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if(process.env.VERCEL||process.env.NETLIFY){const fs=require('fs');fs.mkdirSync('/tmp',{recursive:true});if(fs.existsSync('./data/ultrastore.db'))fs.copyFileSync('./data/ultrastore.db','/tmp/ultrastore.db');}\" && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test src/**/*.test.mjs src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node src/db/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
